diff --git a/ESP32-DIV/rfid.cpp b/ESP32-DIV/rfid.cpp
index 66fa216..b2f9138 100644
--- a/ESP32-DIV/rfid.cpp
+++ b/ESP32-DIV/rfid.cpp
@@ -2527,6 +2527,129 @@ void sessionClone() {
   rfidResultAndDismiss("Clone", "Done", summary);
 }
 
+/*
+ * Read & Write — quick "swipe" UID clone.
+ *
+ * Optimised for the common access-fob case: capture a source MIFARE Classic
+ * tag's UID (block 0), then program it onto a Gen2 "magic" blank card in one
+ * short flow. For full-memory copies of Ultralight / NTAG tags, use the
+ * existing "Card Clone" flow instead.
+ *
+ * NOTE ON RANGE: this uses the same PN532 13.56 MHz coil as every other RFID
+ * tool here. Practical read range is ~2-5 cm (7 cm at best with a good coil).
+ * "Swipe" here means a slow, close pass over the coil — not a 10-20 cm read,
+ * which is not physically possible at this frequency.
+ */
+void sessionReadWrite() {
+  uint8_t uid[7] = {0};
+  uint8_t uidLength = 0;
+  uint8_t keyA[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+  uint8_t keyB[6] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
+  uint8_t keyZero[6] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00};
+  uint8_t block0[16] = {0};
+  uint8_t srcUid[7] = {0};
+  uint8_t srcUidLen = 0;
+
+  static const char kIntro[] =
+      "Quick UID clone.\n\n"
+      "Step 1/3: swipe the SOURCE fob/card slowly across the coil. "
+      "Keep it flat and close (best under ~3 cm).";
+
+  rfidAttachBus();
+  if (!rfidListenIso14443a("Read & Write", "Cancel", uid, &uidLength,
+                           (unsigned long)RFID_CLONE_PHASE_TIMEOUT_MS,
+                           "Step 1/3 — Swipe SOURCE tag", kIntro)) {
+    rfidRestoreBus();
+    return;
+  }
+
+  memcpy(srcUid, uid, uidLength);
+  srcUidLen = uidLength;
+  char uidStr[24] = "";
+  uidToHex(uidStr, sizeof(uidStr), srcUid, srcUidLen);
+
+  CardType ct = detectCardType(uid, uidLength);
+  rfidSetDynamicPill("OK", UI_OK);
+  rfidSetBandAux(nullptr);
+  rfidDynamicBand(0, "Source captured", uidStr);
+  rfidPrint(String("[+] Source ") + uidStr + "  " + cardTypeStr(ct), UI_OK, false);
+
+  if (ct != MIFARE_CLASSIC) {
+    rfidRestoreBus();
+    rfidResultAndDismiss("Read & Write", "Use Card Clone",
+                         "Quick UID clone supports MIFARE Classic magic cards.\n\n"
+                         "For Ultralight / NTAG use 'Card Clone' (full data copy).");
+    return;
+  }
+
+  bool haveBlock0 = false;
+  if (s_nfc.mifareclassic_AuthenticateBlock(uid, uidLength, 0, 0, keyA) &&
+      s_nfc.mifareclassic_ReadDataBlock(0, block0)) {
+    haveBlock0 = true;
+  }
+  rfidRestoreBus();
+
+  static const char kBlankInfo[] =
+      "Step 2/3: remove the source tag.\n\n"
+      "Step 3/3: present a blank Gen2 \"magic\" MIFARE Classic card. "
+      "Writing starts automatically once it is detected.";
+
+  rfidAttachBus();
+  if (!rfidListenIso14443a("Read & Write", "Cancel", uid, &uidLength,
+                           (unsigned long)RFID_CLONE_PHASE_TIMEOUT_MS,
+                           "Step 3/3 — Present BLANK magic card", kBlankInfo)) {
+    rfidRestoreBus();
+    return;
+  }
+
+  char blankStr[24] = "";
+  uidToHex(blankStr, sizeof(blankStr), uid, uidLength);
+  rfidSetDynamicPill("OK", UI_OK);
+  rfidSetBandAux(nullptr);
+  rfidDynamicBand(0, "Blank detected", blankStr);
+  rfidPrint(String("[+] Blank ") + blankStr, UI_OK, false);
+
+  bool magic = tryMagicBackdoor();
+
+  uint8_t block0Data[16];
+  if (haveBlock0) {
+    memcpy(block0Data, block0, 16);
+  } else {
+    memset(block0Data, 0, sizeof(block0Data));
+    memcpy(block0Data, srcUid, srcUidLen);
+    block0Data[4] =
+        (uint8_t)(block0Data[0] ^ block0Data[1] ^ block0Data[2] ^ block0Data[3]);
+  }
+
+  bool wrote = false;
+  bool auth = s_nfc.mifareclassic_AuthenticateBlock(uid, uidLength, 0, 0, keyA);
+  if (!auth) {
+    auth = s_nfc.mifareclassic_AuthenticateBlock(uid, uidLength, 0, 1, keyB);
+  }
+  if (!auth) {
+    auth = s_nfc.mifareclassic_AuthenticateBlock(uid, uidLength, 0, 0, keyZero);
+  }
+  if (auth && s_nfc.mifareclassic_WriteDataBlock(0, block0Data)) {
+    wrote = true;
+  }
+  rfidRestoreBus();
+
+  char summary[360];
+  const char* fw = s_pn532VerStr[0] ? s_pn532VerStr : "PN532";
+  snprintf(summary, sizeof(summary),
+           "%s\n\n"
+           "Source UID: %s\n"
+           "Blank UID:    %s\n"
+           "Reader IC:    %s\n"
+           "Gen2 magic:   %s\n"
+           "UID block write: %s\n\n"
+           "Verify by re-scanning with Card Reader.",
+           wrote ? "UID written to blank." : "UID write failed.",
+           uidStr, blankStr, fw, magic ? "detected" : "not detected",
+           wrote ? "OK" : "failed");
+  rfidResultAndDismiss("Read & Write", wrote ? "Done" : "Failed", summary);
+}
